{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BetterTrumpet",
  "version": "0.1.0",
  "identifier": "com.bettertrumpet.rust-preview",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "flyout",
        "title": "BetterTrumpet",
        "url": "index.html",
        "width": 380,
        "height": 520,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
